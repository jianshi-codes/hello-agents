{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Install local Python baseline",
      "type": "shell",
      "command": "${workspaceFolder}/.venv/bin/python",
      "args": [
        "-m",
        "pip",
        "install",
        "-r",
        "${workspaceFolder}/requirements-local.txt"
      ],
      "problemMatcher": []
    },
    {
      "label": "Run chapter1 smoke test",
      "type": "shell",
      "command": "${workspaceFolder}/.venv/bin/python",
      "args": [
        "${workspaceFolder}/code/chapter1/FirstAgentTest.py"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    }
  ]
}
