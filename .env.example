# Copy this file to .env and fill in the values you use.
#
# OpenAI-compatible LLM endpoint. Examples:
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_BASE_URL=https://api.deepseek.com
# LLM_BASE_URL=https://api-inference.modelscope.cn/v1/
LLM_API_KEY=your_openai_compatible_api_key
LLM_BASE_URL=your_openai_compatible_base_url
LLM_MODEL_ID=your_model_id

API_KEY=your_openai_compatible_api_key
BASE_URL=your_openai_compatible_base_url
MODEL_ID=your_model_id

# Some early chapter scripts use these older names. Keep them aligned with LLM_*.
OPENAI_API_KEY=your_openai_compatible_api_key
OPENAI_BASE_URL=your_openai_compatible_base_url
MODEL_NAME=your_model_id

# Required by code/chapter1/FirstAgentTest.py after the weather step.
TAVILY_API_KEY=your_tavily_api_key
